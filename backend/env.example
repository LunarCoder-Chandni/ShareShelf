# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Supabase (Project Settings -> API). The service-role key is SECRET: backend only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public storage bucket for item/service photos
SUPABASE_STORAGE_BUCKET=shareshelf-images

# Restrict signups to your college. Comma-separated, leave empty to allow any email.
# Example: ALLOWED_EMAIL_DOMAINS=mycollege.edu.in
ALLOWED_EMAIL_DOMAINS=
